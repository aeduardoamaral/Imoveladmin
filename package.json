{
  "name": "imoveladmin",
  "version": "1.0.0",
  "description": "ImovelAdmin - plataforma de administração de condomínios",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/src/server.js",
    "migrate": "tsx --env-file=.env src/scripts/migrate.ts",
    "master:create": "tsx --env-file=.env src/scripts/create-master.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aeduardoamaral/Imoveladmin.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/aeduardoamaral/Imoveladmin/issues"
  },
  "homepage": "https://github.com/aeduardoamaral/Imoveladmin#readme",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "private": true
}
