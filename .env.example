NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Papel de RUNTIME: sem ownership das tabelas, sujeito a Row-Level Security.
DATABASE_URL=postgres://imovel_app:TROQUE@localhost:5432/imoveladmin
# Papel DONO: usado somente para migrações.
DATABASE_OWNER_URL=postgres://imovel_owner:TROQUE@localhost:5432/imoveladmin
APP_DB_ROLE=imovel_app

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 32 bytes em base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# Origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
# Número de proxies reversos confiáveis à frente da API (0 = nenhum)
TRUST_PROXY_HOPS=0
# URL do front-end usada para montar links de convite
APP_PUBLIC_URL=http://localhost:5173
